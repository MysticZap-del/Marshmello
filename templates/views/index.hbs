                        <p>We are a team of <span class="bold-style">Professional Developers 👌</span></p>
                        
                        <button class="btn-style btn-primary">Our Services</button>
                    </div>
                    {{!-- Right Side --}}
                    <div class="col-md-6 col-12 hero-text order-md-1 order-0">
                        <img src="/images/growth.png" alt="Hero Image" class="img-fluid">
                    </div>
                </div>

            </div>
        </div>
    </div>
    {{!-- Hero Section Ends --}}

    {{!-- About Section Starts --}}

    {{>about}}

    {{!-- About Section Ends --}}

    {{!-- Service Section Starts --}}
    
    {{>services}}

    {{!-- Service Section Ends --}}

    {{!-- Service Section Starts --}}
    
    {{>maps}}

    {{!-- Service Section Ends --}}

    {{!-- About Section Starts --}}

    {{>contact}}

    {{!-- About Section Ends --}}

    <script src="/jq/jquery.min.js" type="text/javascript"></script>
    <script src="/js/bootstrap.min.js" type="text/javascript"></script>
